# Backend environment variables
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MODEL_NAME=claude-haiku-5-5

# Use Supabase or Neon Postgres connection string in production:
# postgresql://user:password@host:5432/dbname?sslmode=require
# Leave blank locally to use SQLite fallback (./shopbot_local.db)
DATABASE_URL=

# Optional comma-separated frontend origins for CORS (* allows all)
CORS_ORIGINS=*

# Frontend environment variable (set on Vercel or frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
